generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"  // postgresql, mysql, sqlite, mongodb 등 선택 가능
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
}

model Event {
  id        Int       @id @default(autoincrement())
  title     String
  start     DateTime
  end       DateTime
  category  String?
  createdAt DateTime  @default(now())
}